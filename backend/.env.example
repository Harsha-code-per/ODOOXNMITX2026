# =============================================================================
# Dayflow HRMS — Environment Configuration Example (.env.example)
# =============================================================================

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dayflow
# For Local SQLite testing (optional):
# DATABASE_URL=sqlite+aiosqlite:///./dayflow.db

# Server & Port
PORT=8000
ENVIRONMENT=development

# JWT Authentication
JWT_SECRET_KEY=change_me_in_production_super_secret_jwt_key_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Resend Email Delivery Service
RESEND_API_KEY=
EMAIL_FROM=onboarding@yourdomain.com
APP_BASE_URL=http://localhost:3000

# CORS Allowed Origins (JSON array or comma-separated string)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
