# =============================================================================
# Dayflow HRMS Frontend — Environment Variables Example (.env.example)
# =============================================================================

# Set to "false" to connect to the live FastAPI backend.
# Set to "true" if you want to run purely offline in mock mode with browser localStorage.
NEXT_PUBLIC_USE_MOCK=false

# Base URL for the FastAPI Backend REST API (including the /api/v1 prefix)
# - For Local Development: http://localhost:8000/api/v1
# - For Production (e.g. Render / Railway): https://your-backend-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
